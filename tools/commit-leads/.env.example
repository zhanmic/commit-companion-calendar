# Ollama OpenAI-compatible API
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:8b

# Delay between outbound HTTP requests (ms)
RATE_LIMIT_MS=1500

# Headless Chromium network fingerprint (1=on, 0=off). Needs: npx playwright install chromium
FINGERPRINT_NETWORK=1

# Web UI (npm run ui)
# PORT=3847
# Bind 0.0.0.0 so iPhone on same Wi‑Fi can open the LAN URL printed at startup
# Use 127.0.0.1 for Mac-only access
HOST=0.0.0.0

# Outreach drafts (Generate draft → Open in Mail)
SITE_URL=https://myswimday.com
DEMO_CALENDAR_URL=https://myswimday.com/DelmarDolphins
SENDER_NAME=Mic Zhan from MySwimDay
SENDER_CONTEXT=I am a parent of four swimmers at Delmar Dolphins.
