# Ollama OpenAI-compatible API
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:8b

# Delay between outbound HTTP requests (ms)
RATE_LIMIT_MS=1500

# Headless Chromium network fingerprint (1=on, 0=off). Needs: npx playwright install chromium
FINGERPRINT_NETWORK=1

# Web UI port (npm run ui)
# PORT=3847
