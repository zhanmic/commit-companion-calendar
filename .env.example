# Resend (https://resend.com) — transactional + digest email
RESEND_API_KEY=re_xxxxxxxx
# Verified domain sender, e.g. My Swim Day <schedule@myswimday.com>
RESEND_FROM_EMAIL=My Swim Day <schedule@myswimday.com>

# Inbound contact mail → Gmail (sales@mail.myswimday.com via Resend Receiving)
# Webhook signing secret from https://resend.com/webhooks
# Also put this in the Resend webhook URL:
#   https://myswimday.com/api/inbound?secret=whsec_xxxxxxxx
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxx
# Where to forward inbound mail
CONTACT_FORWARD_TO=zhanmic@gmail.com
# Comma-separated allowlist of inbound addresses (default: sales@mail.myswimday.com)
# CONTACT_INBOUND_ADDRESSES=sales@mail.myswimday.com

# Upstash Redis REST — subscription storage
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxx

# Protects /api/cron/send-digests (Vercel Cron sends Authorization: Bearer …)
CRON_SECRET=replace-with-long-random-string

# Canonical site URL used in confirm / unsubscribe / schedule links
APP_BASE_URL=https://myswimday.com

# ---------------------------------------------------------------------------
# Stripe — full steps: docs/stripe-config.md
# Test mode (use these until a real club pays). Toggle Test/Live in the sidebar.
# Live keys/prices are different ids — never mix sk_test_ with live price_ ids.
# ---------------------------------------------------------------------------

# Secret API key (sk_test_… or sk_live_…)
# Where: Developers → API keys → Secret key
# Test: https://dashboard.stripe.com/test/apikeys
# Live: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_

# Club monthly Price id (price_…) — MUST be $15 / month
# Where: Product catalog → product “My Swim Day — Club” → Prices → monthly $15
# Test: https://dashboard.stripe.com/test/products
# Live: https://dashboard.stripe.com/products
# Do not paste Club Plus ($29) or Program ($49) here — in-app checkout uses this id only.
STRIPE_PRICE_ID=price_

# Club yearly Price id (price_…) — $165 / year (11 months, one month free)
# Where: same Club product → Add price → Recurring → Yearly → $165
# Optional until you offer yearly. Leave blank to skip.
STRIPE_PRICE_ID_ANNUAL=

# Webhook signing secret (whsec_…)
# Where: Developers → Webhooks → your endpoint → Signing secret
# Endpoint URL (production): https://myswimday.com/api/billing/webhook
# Events: checkout.session.completed, customer.subscription.created,
#   customer.subscription.updated, customer.subscription.deleted,
#   invoice.paid, invoice.payment_failed
# Test: https://dashboard.stripe.com/test/webhooks
# Live: https://dashboard.stripe.com/webhooks
# Local: `stripe listen --forward-to localhost:5173/api/billing/webhook` prints a whsec_
STRIPE_WEBHOOK_SECRET=whsec_

# Checkout TOS checkbox. Set to 1 only after Dashboard has Terms URL.
# Where: Settings → Checkout / Public details → Terms of Service
#   URL: https://myswimday.com/terms
# https://dashboard.stripe.com/settings/checkout
STRIPE_CHECKOUT_REQUIRE_TOS=

# Also in Dashboard (no env var): Customer portal — allow cancel + update card
# https://dashboard.stripe.com/settings/billing/portal
#
# Club Plus / Program ($29 / $49, yearly $319 / $539): create Prices in Dashboard
# and Payment Links. Do not put those price ids in STRIPE_PRICE_ID.

# ---------------------------------------------------------------------------
# Billing ops secrets — you generate these (not from Stripe)
#   openssl rand -hex 24
# ---------------------------------------------------------------------------

# Bearer token for POST /api/billing/checkout and /api/billing/portal (curl)
BILLING_ADMIN_SECRET=

# Optional second ops secret (can be the same as BILLING_ADMIN_SECRET)
BILLING_UI_SECRET=

# Team admin passwords (Settings → Team, or ?ta=). You choose these — not from Stripe.
# JSON map of tenant slug → password. Copy the same value to Vercel Production.
TEAM_ADMIN_TOKENS={"DelmarDolfins":"replace-me","VortexSwimClub":"replace-me"}
# Or per tenant:
# TEAM_ADMIN_TOKEN_DELMARDOLFINS=replace-me
# TEAM_ADMIN_TOKEN_VORTEXSWIMCLUB=replace-me

# Operator schedule admin (advanced Calendar toggles). Unlock: ?admin=<password>
OPERATOR_ADMIN_PASSWORD=replace-with-long-random-string
# Clear with ?admin=0. Legacy ?admin=1 no longer grants access.

# Public schedule API (/api/schedule) — hourly caps scale with team size
# (groups × 35 households × this number). Redis required to enforce.
# PUBLIC_API_ASKS_PER_HOUSEHOLD=4
# Set to 1 only for local load tests; leave unset in production.
# PUBLIC_API_DISABLE_RATE_LIMIT=1
