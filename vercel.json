{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/billing/checkout",
      "destination": "/api/billing?op=checkout"
    },
    {
      "source": "/api/billing/portal",
      "destination": "/api/billing?op=portal"
    },
    {
      "source": "/api/billing/team-session",
      "destination": "/api/billing?op=team-session"
    },
    {
      "source": "/api/billing/operator-session",
      "destination": "/api/billing?op=operator-session"
    },
    {
      "source": "/api/billing/webhook",
      "destination": "/api/billing?op=webhook"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/send-digests",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/send-digests",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/send-digests",
      "schedule": "0 2 * * *"
    },
    {
