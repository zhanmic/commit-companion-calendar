{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron/send-daily",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/send-weekly",
      "schedule": "0 22 * * 0"
    }
  ]
}
